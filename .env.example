# --- Geral ---
ENV=development
PORT=3000

# --- Banco de dados (desenvolvimento) ---
DB_DEV_USER=
DB_DEV_PASSWORD=
DB_DEV_HOST=
DB_DEV_PORT=5432
DB_DEV_DATABASE=

# --- Banco de dados (produção) ---
DB_PROD_USER=
DB_PROD_PASSWORD=
DB_PROD_HOST=
DB_PROD_PORT=5432
DB_PROD_DATABASE=

# --- SMTP (relatório diário) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# --- Pluggy (Open Finance) ---
# Client ID/Secret da sua aplicação no Dashboard da Pluggy (ambiente sandbox/dev por enquanto)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Normalmente não precisa mudar; existe caso a Pluggy tenha um endpoint separado por região/ambiente
PLUGGY_BASE_URL=https://api.pluggy.ai
# URL PÚBLICA do seu backend + /api/pluggy/webhook (a Pluggy precisa conseguir alcançá-la;
# em dev local, use algo como ngrok e atualize aqui)
PLUGGY_WEBHOOK_URL=https://SEU-DOMINIO/api/pluggy/webhook
# Expressão cron do job de reconciliação (rede de segurança, o webhook é o mecanismo principal)
PLUGGY_SYNC_CRON=*/30 * * * *
# Quantos dias pra trás o job de reconciliação revisita (não confundir com a busca retroativa
# completa, que roda 1x quando o item é conectado pela primeira vez)
PLUGGY_RECONCILE_LOOKBACK_DAYS=3
