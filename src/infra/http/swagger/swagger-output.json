    "/api/pluggy/connections": {
      "post": {
        "tags": [
          "Pluggy"
        ],
        "summary": "Conecta um Item da Pluggy a um usuário",
        "description": "Vincula um Item (conexão bancária) já existente na Pluggy ao usuário, cria os cards de crédito correspondentes e dispara a busca retroativa de despesas.",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string"
                  },
                  "itemId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/pluggy/webhook": {
      "post": {
        "tags": [
          "Pluggy"
        ],
        "summary": "Webhook de eventos da Pluggy",
        "description": "Endpoint chamado pela Pluggy quando há novas transações, atualizações ou exclusões.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    }
